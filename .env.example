# Environment Variables Template
# Copy to .env and fill in your values

# ─── Database Credentials ────────────────────────────────
POSTGRES_PASSWORD=your_secure_postgres_password
MONGO_PASSWORD=your_secure_mongo_password
REDIS_PASSWORD=your_secure_redis_password

# ─── JWT Secrets ─────────────────────────────────────────
JWT_SECRET=your_256_bit_jwt_secret_here
JWT_REFRESH_SECRET=your_256_bit_refresh_secret_here

# ─── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Retell AI (AI Voice Agent) ──────────────────────────
RETELL_API_KEY=key_3acd90982316f78ff63c2367469b
RETELL_AGENT_ID=agent_cbc4d9dffbfd3df155cccb4828
RETELL_WEBHOOK_SECRET=your_webhook_secret_here
RETELL_BASE_URL=https://api.retellai.com

# ─── Twilio (Voice Calls — used by Retell for PSTN) ─────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ─── Deepgram (Speech-to-Text) ───────────────────────────
DEEPGRAM_API_KEY=...

# ─── ElevenLabs (Text-to-Speech) ─────────────────────────
ELEVENLABS_API_KEY=...

# ─── LiveKit (Real-time Voice) ───────────────────────────
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...

# ─── Google OAuth / Calendar ─────────────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# ─── Microsoft OAuth / Outlook Calendar ──────────────────
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...

# ─── Grafana ─────────────────────────────────────────────
GRAFANA_PASSWORD=admin_password_here

# ─── Facebook Ads Webhook ────────────────────────────────
FACEBOOK_VERIFY_TOKEN=your_webhook_verify_token

# ─── Sentry ──────────────────────────────────────────────
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
