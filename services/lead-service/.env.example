# ─────────────────────────────────────────────────────────────────────────────
# lead-service environment configuration
# Copy this file to .env and fill in the values before running the service.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="AI Platform Lead Service"
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lead_user:lead_pass@localhost:5432/lead_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1
REDIS_TTL=3600

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=lead-service
KAFKA_TOPIC_LEAD_CREATED=lead.created
KAFKA_TOPIC_LEAD_STATUS_CHANGED=lead.status_changed

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_super_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Facebook Lead Ads ─────────────────────────────────────────────────────────
FACEBOOK_VERIFY_TOKEN=CHANGE_ME_facebook_verify_token
FACEBOOK_APP_SECRET=CHANGE_ME_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=CHANGE_ME_facebook_access_token
FACEBOOK_API_VERSION=v19.0

# ── Google Ads ────────────────────────────────────────────────────────────────
GOOGLE_WEBHOOK_SECRET=CHANGE_ME_google_webhook_secret

# ── LinkedIn ──────────────────────────────────────────────────────────────────
LINKEDIN_WEBHOOK_SECRET=CHANGE_ME_linkedin_webhook_secret

# ── WhatsApp / Meta ───────────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_whatsapp_verify_token
WHATSAPP_APP_SECRET=CHANGE_ME_whatsapp_app_secret

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Prometheus ────────────────────────────────────────────────────────────────
ENABLE_METRICS=true

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Bulk import ───────────────────────────────────────────────────────────────
BULK_IMPORT_MAX_RECORDS=500
